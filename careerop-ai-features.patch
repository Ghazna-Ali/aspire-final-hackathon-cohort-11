+
+
+# ============================================================
+# BLOCKS: BANNER, DETAILS, SCORE CARD, REQUEST
+# ============================================================
+
+def banner(title, subtitle, accent, styles):
+    cell = [
+        Paragraph("CAREEROPS AI", styles["banner_kicker"]),
