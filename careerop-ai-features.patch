+"""
+Additional CareerOps AI features.
+
+These are NOT new agents. Each feature is an extra task that belongs to
+an EXISTING agent from agents.py, and app.py shows it inside that agent:
+
+    Agent               Extra tasks
+    ------------------  ----------------------------------------
+    CV Analyst          Job Match Score, Skill Gap Detector
+    Application Agent   Cover Letter Generation
+    Manager             Career Roadmap
+
+Nothing in agents.py or tasks.py is modified.
+"""
+
+import re
+
+from crewai import Task
+
+from agents import (
+    manager_agent,
+    cv_agent,
+    application_agent,
+)
+
+
+# ============================================================
